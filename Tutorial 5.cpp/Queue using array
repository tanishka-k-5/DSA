#include <stdio.h>

#define MAX 100

int queue[MAX];
int front = 0, rear = -1;

void enqueue(int n)
{
    if (rear == MAX - 1)
    {
        printf("The Queue is full\n");
    }
    else
    {
        queue[++rear] = n;
    }
}

void dequeue()
{
    if (front > rear)
    {
        printf("The Queue is empty\n");
    }
    else
    {
        printf("Dequeued value from queue: %d\n", queue[front++]);
    }
}

void display()
{
    int i;

    if (front > rear)
    {
        printf("The Queue is empty\n");
    }
    else
    {
        printf("Queue elements are: ");

        for (i = front; i <= rear; i++)
        {
            printf("%d ", queue[i]);
        }

        printf("\n");
    }
}

int main()
{
    int n, i, value;

    printf("Enter number of elements in Queue: ");
    scanf("%d", &n);

    if (n > MAX)
    {
        printf("Maximum queue size is %d\n", MAX);
        return 1;
    }

    for (i = 0; i < n; i++)
    {
        printf("Enter element %d: ", i + 1);
        scanf("%d", &value);
        enqueue(value);
    }
    printf("Queue before dequeue \n");
    display();
    dequeue();
    printf("Queue after dequeue \n");
    display();

    return 0;
}

