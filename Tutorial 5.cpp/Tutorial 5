 #include<stdio.h>
#define MAX 5
int stack[MAX];
int top=-1;
void push(int value)
{
    if(top==MAX-1)
    {
        printf("Stack Overflow!Cannot push%d.\n",value);
    }
    else
    {
        stack[++top]=value;
        printf("Pushed %d to stack.\n",value);
    }
}
void pop() {
    if (top==-1){
        printf("Stack underflow!Cannot pop.\n");
    }else {
        printf("Popped %d from the stack.\n",stack[top--]);
    }
}
void peek()
{
    if (top==-1)
    {
        printf("Stack is empty.\n");
    }
    else
    {
    printf("Top element is %d.\n", stack[top]);
    }
}
void display() {
    if (top == -1) {
        printf("Stack is empty.\n");
        return;
    }
    printf("Stack elements (from top to bottom): ");
    for (int i = top; i >= 0; i--) {
        printf("%d ", stack[i]);
    }
    printf("\n");
}
int main()
{
push(1);
push(2);
push(3);
peek();
pop();
display ();
return 0;
}

